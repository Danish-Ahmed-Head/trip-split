rules_version = '2';

// Trip Split: Firestore Security Rules
//
// Covers the default/legacy trip (flat paths: /members, /expenses, /recurring,
// /settings/trip) and trips created via "Start a new trip" (nested under
// /trips/{tripId}/...). Per-user data lives at /users/{uid}.
//
// Identity: a signed-in user is linked to a trip member by a doc at
// memberLinks/{uid} -> {memberId}. Rules can only look documents up by exact
// path (no "find where authUid == uid"), so this index is what lets a rule ask
// "which member is this Google account?". The link is only accepted when the
// member doc itself already carries that uid (checked with getAfter so the
// claim and the link can be written in one batch).
//
// Tests: tests/rules.test.mjs (npm run test:rules, needs Java for the emulator).
// Deploy: paste into Firebase Console -> Firestore Database -> Rules -> Publish,
// or `firebase deploy --only firestore:rules`.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // true when `memberId` is the member this signed-in user is linked to
    function isMember(linksDocPath, memberId) {
      return memberId != null
        && exists(linksDocPath)
        && get(linksDocPath).data.memberId == memberId;
    }

    // Fields such as authUid/confirmedBy/ownerUid are ABSENT (not null) on
    // documents written before this model existed, so check absence too.
    function isUnset(data, field) {
      return !(field in data) || data[field] == null;
    }

    // field exists AND equals value (a plain == on a missing field is an error)
    function fieldIs(data, field, value) {
      return field in data && data[field] == value;
    }

    function isOwnerOf(tripDocPath) {
      return exists(tripDocPath) && fieldIs(get(tripDocPath).data, 'ownerUid', request.auth.uid);
    }

    // A closed trip takes no new expenses (settling up still works).
    function isTripOpen(tripDocPath) {
      return !exists(tripDocPath) || get(tripDocPath).data.get('closed', false) != true;
    }

    // ================= default / legacy trip (flat paths) =================

    match /memberLinks/{uid} {
      allow read: if signedIn();
      // once, for yourself, and only for a member doc that already carries your uid
      allow create: if signedIn() && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/memberLinks/$(uid))
        && request.resource.data.memberId is string
        && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.authUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /members/{memberId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (isUnset(request.resource.data, 'authUid') || fieldIs(request.resource.data, 'authUid', request.auth.uid));
      allow update: if signedIn() && (
        // claiming a still-unclaimed member: only authUid, only once
        (fieldIs(request.resource.data, 'authUid', request.auth.uid) && isUnset(resource.data, 'authUid')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid']))
        ||
        // the member themself edits name/active, never their own link
        (fieldIs(resource.data, 'authUid', request.auth.uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authUid', 'createdAt']))
        ||
        isOwnerOf(/databases/$(database)/documents/settings/trip)
      );
      allow delete: if false; // soft-delete only (active:false)
    }

    match /expenses/{expenseId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.amount is number && request.resource.data.amount > 0 && (
        // a settlement can only be raised by the payer, and never pre-confirmed
        (request.resource.data.type == 'settlement'
          && isMember(/databases/$(database)/documents/memberLinks/$(request.auth.uid), request.resource.data.payerId)
          && isMember(/databases/$(database)/documents/memberLinks/$(request.auth.uid), request.resource.data.addedBy)
          && isUnset(request.resource.data, 'confirmedBy'))
        ||
        // a normal expense: trip open, authored by you (or by a repeating template you can vouch for)
        (request.resource.data.type != 'settlement'
          && isTripOpen(/databases/$(database)/documents/settings/trip)
          && (isMember(/databases/$(database)/documents/memberLinks/$(request.auth.uid), request.resource.data.addedBy)
              || ('recurringId' in request.resource.data && request.resource.data.recurringId is string
                  && exists(/databases/$(database)/documents/recurring/$(request.resource.data.recurringId))
                  && get(/databases/$(database)/documents/recurring/$(request.resource.data.recurringId)).data.createdBy == request.resource.data.addedBy)))
      );
      allow update: if signedIn() && (
        // the creditor confirming or disputing a pending settlement, once
        (resource.data.type == 'settlement'
          && isMember(/databases/$(database)/documents/memberLinks/$(request.auth.uid), resource.data.participantIds[0])
          && isUnset(resource.data, 'confirmedBy')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['confirmedBy', 'confirmedAt', 'disputed', 'disputedBy', 'disputedAt']))
        ||
        // the author edits / soft-deletes a normal expense, never authorship or settlement fields
        (resource.data.type != 'settlement'
          && isMember(/databases/$(database)/documents/memberLinks/$(request.auth.uid), resource.data.addedBy)
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['addedBy', 'type', 'createdAt', 'confirmedBy', 'confirmedAt', 'disputed', 'disputedBy', 'disputedAt']))
        ||
        // the payer may withdraw their own still-pending settlement (soft delete/restore only)
        (resource.data.type == 'settlement'
          && isMember(/databases/$(database)/documents/memberLinks/$(request.auth.uid), resource.data.addedBy)
          && isUnset(resource.data, 'confirmedBy')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['deleted', 'deletedBy', 'deletedAt']))
        ||
        isOwnerOf(/databases/$(database)/documents/settings/trip)
      );
      allow delete: if false;
    }

    match /recurring/{recId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.interval in ['weekly', 'monthly']
        && isMember(/databases/$(database)/documents/memberLinks/$(request.auth.uid), request.resource.data.createdBy)
        && isTripOpen(/databases/$(database)/documents/settings/trip);
      // pause / resume only, by whoever set it up or the owner
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && (isMember(/databases/$(database)/documents/memberLinks/$(request.auth.uid), resource.data.createdBy)
            || isOwnerOf(/databases/$(database)/documents/settings/trip));
      allow delete: if false;
    }

    match /settings/trip {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(/databases/$(database)/documents/settings/trip);
      allow update: if signedIn() && (
        // one-time ownership claim on the pre-existing default trip
        (isUnset(resource.data, 'ownerUid')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid']))
        || fieldIs(resource.data, 'ownerUid', request.auth.uid)
        // the one-time seed-members race flag
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seeded'])
      );
    }

    // ================= per-user data =================

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ================= created trips (nested paths) =================

    match /trips/{tripId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (
        (isUnset(resource.data, 'ownerUid')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid']))
        || fieldIs(resource.data, 'ownerUid', request.auth.uid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seeded'])
      );

      match /memberLinks/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid
          && !exists(/databases/$(database)/documents/trips/$(tripId)/memberLinks/$(uid))
          && request.resource.data.memberId is string
          && getAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.resource.data.memberId)).data.authUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /members/{memberId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && (isUnset(request.resource.data, 'authUid') || fieldIs(request.resource.data, 'authUid', request.auth.uid));
        allow update: if signedIn() && (
          (fieldIs(request.resource.data, 'authUid', request.auth.uid) && isUnset(resource.data, 'authUid')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid']))
          ||
          (fieldIs(resource.data, 'authUid', request.auth.uid)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authUid', 'createdAt']))
          ||
          isOwnerOf(/databases/$(database)/documents/trips/$(tripId))
        );
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.amount is number && request.resource.data.amount > 0 && (
          (request.resource.data.type == 'settlement'
            && isMember(/databases/$(database)/documents/trips/$(tripId)/memberLinks/$(request.auth.uid), request.resource.data.payerId)
            && isMember(/databases/$(database)/documents/trips/$(tripId)/memberLinks/$(request.auth.uid), request.resource.data.addedBy)
            && isUnset(request.resource.data, 'confirmedBy'))
          ||
          (request.resource.data.type != 'settlement'
            && isTripOpen(/databases/$(database)/documents/trips/$(tripId))
            && (isMember(/databases/$(database)/documents/trips/$(tripId)/memberLinks/$(request.auth.uid), request.resource.data.addedBy)
                || ('recurringId' in request.resource.data && request.resource.data.recurringId is string
                    && exists(/databases/$(database)/documents/trips/$(tripId)/recurring/$(request.resource.data.recurringId))
                    && get(/databases/$(database)/documents/trips/$(tripId)/recurring/$(request.resource.data.recurringId)).data.createdBy == request.resource.data.addedBy)))
        );
        allow update: if signedIn() && (
          (resource.data.type == 'settlement'
            && isMember(/databases/$(database)/documents/trips/$(tripId)/memberLinks/$(request.auth.uid), resource.data.participantIds[0])
            && isUnset(resource.data, 'confirmedBy')
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['confirmedBy', 'confirmedAt', 'disputed', 'disputedBy', 'disputedAt']))
          ||
          (resource.data.type != 'settlement'
            && isMember(/databases/$(database)/documents/trips/$(tripId)/memberLinks/$(request.auth.uid), resource.data.addedBy)
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['addedBy', 'type', 'createdAt', 'confirmedBy', 'confirmedAt', 'disputed', 'disputedBy', 'disputedAt']))
          ||
          (resource.data.type == 'settlement'
            && isMember(/databases/$(database)/documents/trips/$(tripId)/memberLinks/$(request.auth.uid), resource.data.addedBy)
            && isUnset(resource.data, 'confirmedBy')
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['deleted', 'deletedBy', 'deletedAt']))
          ||
          isOwnerOf(/databases/$(database)/documents/trips/$(tripId))
        );
        allow delete: if false;
      }

      match /recurring/{recId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.interval in ['weekly', 'monthly']
          && isMember(/databases/$(database)/documents/trips/$(tripId)/memberLinks/$(request.auth.uid), request.resource.data.createdBy)
          && isTripOpen(/databases/$(database)/documents/trips/$(tripId));
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
          && (isMember(/databases/$(database)/documents/trips/$(tripId)/memberLinks/$(request.auth.uid), resource.data.createdBy)
              || isOwnerOf(/databases/$(database)/documents/trips/$(tripId)));
        allow delete: if false;
      }
    }
  }
}
